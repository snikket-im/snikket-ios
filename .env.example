# Copy this file to .env.local. Never commit .env.local or an App Store
# Connect private key.

# Generate a team API key with the Developer role at:
# https://appstoreconnect.apple.com/access/integrations/api
# The issuer ID and key ID are shown when the key is created.
ASC_KEY_PATH="AuthKey_[KEY_ID].p8"
ASC_KEY_ID=""
ASC_ISSUER_ID=""

# Optional simulator name or UDID. If empty, scripts/snikket uses a booted
# iPhone simulator or boots the first available iPhone simulator.
SNIKKET_SIMULATOR=""

# Optional launch-only credentials for a Debug simulator build.
SNIKKET_TEST_JID=""
SNIKKET_TEST_PASSWORD=""
